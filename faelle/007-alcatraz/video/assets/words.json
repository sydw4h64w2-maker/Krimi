"units": [
[
0.0,
"Das sicherste Gefängnis der USA."
],
[
2.944,
"Eine Insel mitten in der Bucht von San Francisco."
],
[
6.358,
"Und drei Männer,"
],
[
7.602,
"die einfach verschwinden."
],
[
9.756,
"Alcatraz,"
],
[
10.854,
"neunzehnhundertzweiundsechzig."
],
[
13.115,
"Die Häftlinge Frank Morris und die Brüder John und Clarence Anglin planen ihren Ausbruch –"
],
[
18.995,
"monatelang."
],
[
20.425,
"Mit Werkzeugen,"
],
[
21.214,
"unter anderem aus Löffeln,"
],
[
22.794,
"vergrößern sie die Lüftungsöffnungen in ihren Zellen."
],
[
26.275,
"Die Löcher verstecken sie hinter falschen Gittern."
],
[
29.253,
"Am Abend des elften Juni neunzehnhundertzweiundsechzig ist es so weit."
],
[
33.628,
"In ihren Betten lassen sie nachgebaute Köpfe zurück –"
],
[
37.034,
"mit echtem Menschenhaar."
],
[
38.997,
"Die Wärter sollen glauben,"
],
[
40.441,
"sie schlafen."
],
[
41.571,
"Die drei klettern durch die Lüftungsschächte aufs Dach und hinunter zum Ufer."
],
[
46.054,
"Dort bauen sie ein Floß zusammen –"
],
[
48.284,
"aus Dutzenden Regenmänteln."
],
[
50.473,
"Dann paddeln sie hinaus in die eiskalte Bucht."
],
[
54.11,
"Ein vierter Häftling,"
],
[
55.235,
"Allen West,"
],
[
55.911,
"sollte mitkommen."
],
[
57.527,
"Er schafft es nicht rechtzeitig aus seiner Zelle."
],
[
60.469,
"Später erzählt er dem FBI den ganzen Plan."
],
[
63.932,
"Am nächsten Morgen entdecken die Wärter die Puppenköpfe."
],
[
67.272,
"Die Betten sind leer."
],
[
69.047,
"Die Fahndung beginnt."
],
[
70.725,
"Aber die drei werden nie gefunden."
],
[
73.542,
"Neunzehnhundertneunundsiebzig schließt das FBI den Fall:"
],
[
77.048,
"Die Männer seien vermutlich ertrunken."
],
[
79.543,
"Doch der U.S."
],
[
80.122,
"Marshals Service hat die Akte offen gehalten."
],
[
83.292,
"Und Alcatraz?"
],
[
84.796,
"Wurde ein Jahr nach der Flucht geschlossen."
],
[
87.586,
"Ertrunken oder entkommen?"
],
[
89.692,
"Schreib's in die Kommentare."
]
]
