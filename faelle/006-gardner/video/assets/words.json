[
7.539,
"über fünfhundert Millionen Dollar."
],
[
10.329,
"Achtzehnter März neunzehnhundertneunzig,"
],
[
12.826,
"mitten in der Nacht."
],
[
14.262,
"Zwei Männer in Polizeiuniform klingeln am Isabella Stewart Gardner Museum."
],
[
19.297,
"Sie sagen,"
],
[
19.833,
"sie seien wegen einer Störung gerufen worden."
],
[
22.712,
"Der Wachmann lässt sie herein –"
],
[
24.615,
"entgegen der Vorschriften."
],
[
26.579,
"Ein Fehler."
],
[
27.669,
"Die falschen Polizisten fesseln ihn und einen zweiten Wachmann im Keller."
],
[
32.059,
"Dann haben sie das Museum für sich."
],
[
34.552,
"Einundachtzig Minuten lang."
],
[
36.635,
"Sie nehmen dreizehn Kunstwerke mit."
],
[
39.081,
"Darunter zwei Gemälde von Rembrandt –"
],
[
41.641,
"eines davon sein einziges Seestück:"
],
[
44.376,
"Der Sturm auf dem See Genezareth."
],
[
46.922,
"Dazu Das Konzert von Vermeer,"
],
[
49.48,
"ein Bild von Manet und fünf Zeichnungen von Degas."
],
[
53.3,
"Es ist bis heute der größte Kunstraub der Geschichte."
],
[
56.937,
"Das FBI ermittelt seit über dreißig Jahren."
],
[
60.531,
"Zweitausenddreizehn erklärt es:"
