[
63.936,
"wer die Täter waren."
],
[
65.672,
"Später heißt es,"
],
[
66.957,
"die beiden seien inzwischen tot."
],
[
69.215,
"Doch die Bilder?"
],
[
70.377,
"Sind nie wieder aufgetaucht."
],
[
72.526,
"Das Museum bietet bis zu zehn Millionen Dollar Belohnung."
],
[
76.34,
"Und wegen einer Bestimmung im Testament der Museumsgründerin hängen die leeren Rahmen bis heute an der Wand."
],
[
